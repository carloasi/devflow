# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust / tauri
# Sem isto o primeiro commit levaria junto os artefatos de build do Rust —
# alguns gigabytes, e inúteis pra quem clona.
/src-tauri/target/
/src-tauri/gen/schemas/

# Configuração local do Claude Code. Não faz parte do DevFlow: são skills e
# ajustes de quem desenvolve, e a skill de fluxos carrega material interno da
# empresa (catálogo de endpoints e padrões de auth do Barramento B2B / Portal
# de Grupos), que não tem por que viajar com o código.
.claude/
